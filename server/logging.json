{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "chat_only": {"()": "request_logging.ChatAccessFilter"}
  },
  "formatters": {
    "plain": {"format": "%(message)s"}
  },
  "handlers": {
    "access": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "plain",
      "filters": ["chat_only"]
    }
  },
  "loggers": {
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
